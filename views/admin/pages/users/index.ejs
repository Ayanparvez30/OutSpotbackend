<div class="d-flex justify-content-between align-items-start mb-4">
  <div>
    <h1 class="page-title">User Management</h1>
    <p class="page-subtitle">Profiles, points, inventory and moderation</p>
  </div>
  <a href="/admin/users/export/csv" class="btn btn-gradient"><i class="bi bi-download me-2"></i>Export CSV</a>
</div>

<form method="GET" action="/admin/users" class="mb-3">
  <input type="text" name="q" class="form-control" placeholder="Search by name, email, referral, city..." value="<%= search %>">
</form>

<div class="card">
  <div class="card-body p-0">
    <table class="table table-hover mb-0 align-middle">
      <thead>
        <tr>
          <th>User</th>
          <th>Referral</th>
          <th>Points</th>
          <th>Location</th>
          <th>Joined</th>
          <th>Status</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(u => {
             const avatar = (u.minime && u.minime[0] && u.minime[0].avatarUrl) || null;
             const fullName = [u.firstName, u.lastName].filter(Boolean).join(' ') || u.username;
             const initials = (fullName || '?').trim().split(/\s+/).map(s => s[0]).slice(0, 2).join('').toUpperCase();
        %>
          <tr>
            <td>
              <a href="/admin/users/<%= u.id %>" class="user-cell">
                <% if (avatar) { %>
                  <img src="<%= avatar %>" class="user-avatar" alt="">
                <% } else { %>
                  <span class="user-avatar-fallback"><%= initials %></span>
                <% } %>
                <span>
                  <span class="user-name d-block"><%= fullName %></span>
                  <span class="user-email"><%= u.email || 'no email' %></span>
                </span>
              </a>
            </td>
            <td>
              <% if (u.referredBy && u.referredBy.username) { %>
                <a href="/admin/users?q=<%= encodeURIComponent(u.referredBy.username) %>">@<%= u.referredBy.username %></a>
              <% } else { %>-<% } %>
            </td>
            <td class="fw-semibold"><%= (u.totalPoints || 0).toLocaleString() %></td>
            <td>
              <% if (u.cityName) { %>
                <%= u.cityName %>
              <% } else if (u.Location && u.Location.latitude != null) { %>
                <%= u.Location.latitude.toFixed(2) %>, <%= u.Location.longitude.toFixed(2) %>
              <% } else { %>-<% } %>
            </td>
            <td><%= u.createdAt.toLocaleDateString() %></td>
            <td>
              <% if (u.isBanned) { %>
                <span class="status-pill status-blocked">Blocked</span>
              <% } else if (!u.isActive) { %>
                <span class="status-pill status-inactive">Inactive</span>
              <% } else { %>
                <span class="status-pill status-active">Active</span>
              <% } %>
            </td>
            <td class="text-end">
              <a href="/admin/users/<%= u.id %>/edit" class="row-action" title="Edit"><i class="bi bi-pencil"></i></a>
            </td>
          </tr>
        <% }) %>
        <% if (users.length === 0) { %>
          <tr><td colspan="7" class="text-center text-muted py-3">No users found.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../../partials/pagination', { page, totalPages, baseUrl }) %>
