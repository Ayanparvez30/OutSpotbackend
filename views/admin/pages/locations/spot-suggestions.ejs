<%- include('../../partials/flash') %>

<%
  var CAT_TITLE = {};
  categories.forEach(function (c) { CAT_TITLE[c.key] = c.title; });

  function personName(u) {
    if (!u) return 'Unknown';
    var n = [u.firstName, u.lastName].filter(Boolean).join(' ');
    return n || (u.username ? '@' + u.username : 'user #' + u.id);
  }
  function initials(u) {
    if (!u) return '??';
    var s = ((u.firstName || u.username || '?')[0] || '?') +
            ((u.lastName || u.username || '?')[0] || '?');
    return s.toUpperCase();
  }
  var BADGE = { PENDING: 'bg-warning text-dark', APPROVED: 'bg-success', REJECTED: 'bg-danger' };
%>

<div class="d-flex justify-content-between align-items-center mb-1">
  <h4 class="mb-0">Spot Suggestions</h4>
</div>
<p class="text-muted">
  Places users sent in from Explore while standing at them. Approving one puts
  it on the live map and gives the reporter <%= rewardPoints %> points.
</p>

<!-- Counters double as filters -->
<div class="row g-3 mb-4">
  <% [
       { key: '',         label: 'Total',    value: stats.total,    cls: 'border-primary' },
       { key: 'PENDING',  label: 'Pending',  value: stats.pending,  cls: 'border-warning' },
       { key: 'APPROVED', label: 'Approved', value: stats.approved, cls: 'border-success' },
       { key: 'REJECTED', label: 'Rejected', value: stats.rejected, cls: 'border-danger' }
     ].forEach(function (c) { %>
    <div class="col-md-3">
      <a href="/admin/locations/spot-suggestions<%= c.key ? '?status=' + c.key : '' %>"
         class="text-decoration-none">
        <div class="card h-100 <%= statusFilter === c.key ? c.cls : '' %>"
             style="<%= statusFilter === c.key ? 'border-width:2px' : '' %>">
          <div class="card-body">
            <div class="text-muted small text-uppercase"><%= c.label %></div>
            <div class="h2 mb-0"><%= c.value %></div>
          </div>
        </div>
      </a>
    </div>
  <% }) %>
</div>

<div class="card">
  <div class="card-body p-0">
    <% if (!suggestions || suggestions.length === 0) { %>
      <p class="text-muted text-center py-5 mb-0">
        <% if (statusFilter) { %>
          Nothing <%= statusFilter.toLowerCase() %> right now.
        <% } else { %>
          No suggestions yet. They appear here as users send spots in.
        <% } %>
      </p>
    <% } else { %>
      <table class="table table-hover mb-0 align-middle">
        <thead>
          <tr>
            <th>Reporter</th>
            <th>Proposed spot</th>
            <th>Category</th>
            <th style="width:80px">Photo</th>
            <th style="width:150px">Submitted</th>
            <th style="width:110px">Status</th>
            <th style="width:200px" class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% suggestions.forEach(function (s) { %>
            <tr>
              <td>
                <div class="d-flex align-items-center gap-2">
                  <span class="badge rounded-circle bg-secondary p-2"><%= initials(s.user) %></span>
                  <div>
                    <div class="fw-semibold"><%= personName(s.user) %></div>
                    <% if (s.user && s.user.username) { %>
                      <div class="text-muted small">@<%= s.user.username %></div>
                    <% } %>
                  </div>
                </div>
              </td>
              <td>
                <div class="fw-semibold"><%= s.name %></div>
                <div class="text-muted small"><%= s.address || '—' %></div>
                <div class="text-muted small">
                  <%= s.latitude.toFixed(5) %>, <%= s.longitude.toFixed(5) %>
                </div>
              </td>
              <td>
                <span class="badge bg-secondary">
                  <%= CAT_TITLE[s.categoryKey] || s.categoryKey %>
                </span>
              </td>
              <td>
                <% if (s.imageUrl) { %>
                  <a href="<%= s.imageUrl %>" target="_blank" rel="noopener">
                    <img src="<%= s.imageUrl %>" alt="" class="rounded"
                         style="width:56px;height:56px;object-fit:cover">
                  </a>
                <% } else { %>
                  <span class="text-muted">—</span>
                <% } %>
              </td>
              <td><small><%= new Date(s.createdAt).toLocaleString() %></small></td>
              <td>
                <span class="badge <%= BADGE[s.status] || 'bg-secondary' %>"><%= s.status %></span>
                <% if (s.status === 'REJECTED' && s.rejectReason) { %>
                  <div class="text-muted small mt-1" style="max-width:180px">
                    <%= s.rejectReason %>
                  </div>
                <% } %>
              </td>
              <td class="text-end">
                <% if (s.status === 'PENDING') { %>
                  <button class="btn btn-sm btn-primary"
                          data-bs-toggle="modal" data-bs-target="#approve<%= s.id %>">
                    Create spot
                  </button>
                  <button class="btn btn-sm btn-outline-warning"
                          data-bs-toggle="modal" data-bs-target="#reject<%= s.id %>">
                    Reject
                  </button>
                <% } else if (s.status === 'APPROVED') { %>
                  <a class="btn btn-sm btn-outline-secondary"
                     href="/admin/locations/map-spots">View on map</a>
                <% } %>
                <% if (s.status !== 'APPROVED') { %>
                  <form method="POST" class="d-inline"
                        action="/admin/locations/spot-suggestions/<%= s.id %>/delete"
                        onsubmit="return confirm('Delete &quot;<%= s.name %>&quot; and its photo for good?');">
                    <input type="hidden" name="back"
                           value="/admin/locations/spot-suggestions<%= statusFilter ? '?status=' + statusFilter : '' %>">
                    <button class="btn btn-sm btn-outline-danger">Delete</button>
                  </form>
                <% } %>
              </td>
            </tr>

            <% if (s.status === 'PENDING') { %>
              <!-- Approve: the admin supplies what the user could not -->
              <div class="modal fade" id="approve<%= s.id %>" tabindex="-1">
                <div class="modal-dialog modal-lg">
                  <form method="POST"
                        action="/admin/locations/spot-suggestions/<%= s.id %>/approve">
                    <input type="hidden" name="back"
                           value="/admin/locations/spot-suggestions<%= statusFilter ? '?status=' + statusFilter : '' %>">
                    <div class="modal-content">
                      <div class="modal-header">
                        <div>
                          <h5 class="modal-title mb-0">Create spot profile</h5>
                          <small class="text-muted">
                            Set the points and radius, then publish to the live map.
                          </small>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                      </div>
                      <div class="modal-body">
                        <div class="row g-3">
                          <div class="col-md-8">
                            <label class="form-label">Spot name</label>
                            <input name="name" class="form-control" required
                                   value="<%= s.name %>">
                          </div>
                          <div class="col-md-4">
                            <label class="form-label">Category</label>
                            <select name="categoryKey" class="form-select">
                              <% categories.forEach(function (c) { %>
                                <option value="<%= c.key %>"
                                  <%= c.key === s.categoryKey ? 'selected' : '' %>>
                                  <%= c.title %>
                                </option>
                              <% }) %>
                            </select>
                          </div>

                          <div class="col-md-8">
                            <label class="form-label">Address</label>
                            <input name="address" class="form-control"
                                   value="<%= s.address || '' %>">
                          </div>
                          <div class="col-md-4">
                            <label class="form-label">City</label>
                            <input name="city" class="form-control">
                          </div>

                          <div class="col-12">
                            <label class="form-label">Description</label>
                            <textarea name="description" class="form-control" rows="2"><%= s.note || '' %></textarea>
                          </div>

                          <div class="col-md-6">
                            <label class="form-label">
                              Check-in radius (m) <span class="text-danger">*</span>
                            </label>
                            <input type="number" name="radiusMeters" class="form-control"
                                   value="50" min="10" max="5000" required>
                            <div class="form-text">How close a user must be to check in.</div>
                          </div>
                          <div class="col-md-6">
                            <label class="form-label">
                              Points per check-in <span class="text-danger">*</span>
                            </label>
                            <input type="number" name="points" class="form-control"
                                   value="100" min="1" max="10000" required>
                            <div class="form-text">
                              Google spots derive this from price and reviews; here you set it.
                            </div>
                          </div>

                          <div class="col-12">
                            <div class="alert alert-secondary mb-0">
                              <div class="row">
                                <div class="col-md-6">
                                  <div class="text-muted small">Location (fixed — where the reporter stood)</div>
                                  <code><%= s.latitude.toFixed(6) %>, <%= s.longitude.toFixed(6) %></code>
                                  <div>
                                    <a href="https://www.google.com/maps?q=<%= s.latitude %>,<%= s.longitude %>"
                                       target="_blank" rel="noopener">Open in Google Maps</a>
                                  </div>
                                </div>
                                <% if (s.imageUrl) { %>
                                  <div class="col-md-6 text-end">
                                    <img src="<%= s.imageUrl %>" alt="" class="rounded"
                                         style="max-height:110px;object-fit:cover">
                                  </div>
                                <% } %>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                      <div class="modal-footer">
                        <span class="text-muted small me-auto">
                          <%= personName(s.user) %> gets <%= rewardPoints %> points when you publish.
                        </span>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button class="btn btn-primary">Publish spot</button>
                      </div>
                    </div>
                  </form>
                </div>
              </div>

              <!-- Reject: reason is required, the user is shown it -->
              <div class="modal fade" id="reject<%= s.id %>" tabindex="-1">
                <div class="modal-dialog">
                  <form method="POST"
                        action="/admin/locations/spot-suggestions/<%= s.id %>/reject">
                    <input type="hidden" name="back"
                           value="/admin/locations/spot-suggestions<%= statusFilter ? '?status=' + statusFilter : '' %>">
                    <div class="modal-content">
                      <div class="modal-header">
                        <h5 class="modal-title">Reject "<%= s.name %>"</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                      </div>
                      <div class="modal-body">
                        <label class="form-label">
                          Reason <span class="text-danger">*</span>
                        </label>
                        <textarea name="rejectReason" class="form-control" rows="3" required
                                  maxlength="500"
                                  placeholder="e.g. This place is already on the map"></textarea>
                        <div class="form-text">
                          Sent to <%= personName(s.user) %> as a notification — write it for them to read.
                        </div>
                      </div>
                      <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button class="btn btn-danger">Reject and notify</button>
                      </div>
                    </div>
                  </form>
                </div>
              </div>
            <% } %>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>

  <% if (totalPages > 1) { %>
    <% var qs = statusFilter ? '?status=' + statusFilter + '&' : '?'; %>
    <div class="card-footer d-flex justify-content-between align-items-center">
      <small class="text-muted">Page <%= page %> of <%= totalPages %></small>
      <div>
        <a class="btn btn-sm btn-outline-secondary <%= page <= 1 ? 'disabled' : '' %>"
           href="/admin/locations/spot-suggestions<%= qs %>page=<%= page - 1 %>">Previous</a>
        <a class="btn btn-sm btn-outline-secondary <%= page >= totalPages ? 'disabled' : '' %>"
           href="/admin/locations/spot-suggestions<%= qs %>page=<%= page + 1 %>">Next</a>
      </div>
    </div>
  <% } %>
</div>

<p class="text-muted small mt-3 mb-0">
  Pending suggestions are deleted automatically after 21 days, and rejected ones
  7 days after you act on them — photo included, so the reporter has time to
  read why first. Approved ones are kept as the record behind the live spot;
  remove that from Map Spots instead. Coordinates come from the reporter's
  device and cannot be edited.
</p>
