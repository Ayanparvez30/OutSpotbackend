<%- include('../../partials/flash') %>

<%
  var CAT_TITLE = {};
  categories.forEach(function (c) { CAT_TITLE[c.key] = c.title; });

  function personName(u) {
    if (!u) return 'Unknown';
    var n = [u.firstName, u.lastName].filter(Boolean).join(' ');
    return n || (u.username ? '@' + u.username : 'user #' + u.id);
  }
  function initials(u) {
    if (!u) return '??';
    return (((u.firstName || u.username || '?')[0] || '?') +
            ((u.lastName || u.username || '?')[0] || '?')).toUpperCase();
  }
  var STATUS_CLASS = {
    PENDING:  'badge-pending',
    APPROVED: 'badge-resolved',
    REJECTED: 'status-declined',
  };
%>

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-1">
  <div>
    <h1 class="page-title">Spot Suggestions</h1>
    <p class="page-subtitle mb-0">
      Places users sent in from Explore while standing at them. Approving one
      puts it on the live map and gives the reporter <%= rewardPoints %> points.
    </p>
  </div>
  <a href="/admin/locations/map-spots" class="btn btn-outline-primary">
    <i class="bi bi-pin-map me-2"></i>Map Spots
  </a>
</div>

<!-- Counters double as filters -->
<div class="row g-3 mt-1 mb-4">
  <% [
       { key: '',         label: 'Total',    value: stats.total,    icon: 'inbox' },
       { key: 'PENDING',  label: 'Pending',  value: stats.pending,  icon: 'hourglass-split' },
       { key: 'APPROVED', label: 'Approved', value: stats.approved, icon: 'check2-circle' },
       { key: 'REJECTED', label: 'Rejected', value: stats.rejected, icon: 'x-circle' }
     ].forEach(function (c) { %>
    <div class="col-6 col-xl-3">
      <a href="/admin/locations/spot-suggestions<%= c.key ? '?status=' + c.key : '' %>"
         class="stat-card"
         style="<%= statusFilter === c.key ? 'border-color:#a855f7;box-shadow:0 6px 18px rgba(168,85,247,.18)' : '' %>">
        <div class="stat-top">
          <span class="stat-icon"><i class="bi bi-<%= c.icon %>"></i></span>
        </div>
        <div class="stat-value"><%= c.value %></div>
        <div class="stat-label"><%= c.label %></div>
      </a>
    </div>
  <% }) %>
</div>

<div class="card">
  <div class="card-body p-0">
    <% if (!suggestions || suggestions.length === 0) { %>
      <div class="text-center py-5">
        <i class="bi bi-geo-alt" style="font-size:2rem;opacity:.35"></i>
        <p class="text-muted mt-2 mb-0">
          <% if (statusFilter) { %>
            Nothing <%= statusFilter.toLowerCase() %> right now.
          <% } else { %>
            No suggestions yet. They appear here as users send spots in.
          <% } %>
        </p>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead>
            <tr>
              <th>Reporter</th>
              <th>Proposed spot</th>
              <th style="width:130px">Category</th>
              <th style="width:80px">Photo</th>
              <th style="width:130px">Submitted</th>
              <th style="width:110px">Status</th>
              <th style="width:150px" class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% suggestions.forEach(function (s) { %>
              <tr>
                <td>
                  <div class="fw-semibold"><%= personName(s.user) %></div>
                  <% if (s.user && s.user.username) { %>
                    <div class="text-muted small">@<%= s.user.username %></div>
                  <% } %>
                </td>
                <td>
                  <div class="fw-semibold"><%= s.name %></div>
                  <div class="text-muted small"><%= s.address || '—' %></div>
                  <a class="text-muted small text-decoration-none"
                     href="https://www.google.com/maps?q=<%= s.latitude %>,<%= s.longitude %>"
                     target="_blank" rel="noopener">
                    <i class="bi bi-geo-alt"></i>
                    <%= s.latitude.toFixed(5) %>, <%= s.longitude.toFixed(5) %>
                  </a>
                </td>
                <td>
                  <span class="badge rounded-pill"
                        style="background:rgba(168,85,247,.16);color:#d8b4fe;font-weight:600">
                    <%= CAT_TITLE[s.categoryKey] || s.categoryKey %>
                  </span>
                </td>
                <td>
                  <% if (s.imageUrl) { %>
                    <a href="<%= s.imageUrl %>" target="_blank" rel="noopener">
                      <img src="<%= s.imageUrl %>" alt=""
                           style="width:52px;height:52px;object-fit:cover;border-radius:10px">
                    </a>
                  <% } else { %>
                    <span class="text-muted">—</span>
                  <% } %>
                </td>
                <td>
                  <div class="small"><%= new Date(s.createdAt).toLocaleDateString() %></div>
                  <div class="text-muted small">
                    <%= new Date(s.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
                  </div>
                </td>
                <td>
                  <span class="badge <%= STATUS_CLASS[s.status] || '' %>"><%= s.status %></span>
                  <% if (s.status === 'REJECTED' && s.rejectReason) { %>
                    <div class="text-muted small mt-1" style="max-width:160px">
                      <%= s.rejectReason %>
                    </div>
                  <% } %>
                </td>
                <td class="text-end">
                  <!-- Plain buttons, not a dropdown: the table scrolls
                       horizontally, and a dropdown opened inside a scroll
                       container gets clipped by it. -->
                  <div class="d-flex gap-1 justify-content-end">
                    <% if (s.status === 'PENDING') { %>
                      <button class="btn btn-sm btn-outline-primary" title="Create spot"
                              data-bs-toggle="modal" data-bs-target="#approve<%= s.id %>">
                        <i class="bi bi-check2-circle"></i>
                      </button>
                      <button class="btn btn-sm btn-outline-primary" title="Reject with a reason"
                              data-bs-toggle="modal" data-bs-target="#reject<%= s.id %>">
                        <i class="bi bi-x-circle"></i>
                      </button>
                    <% } else if (s.status === 'APPROVED') { %>
                      <a class="btn btn-sm btn-outline-primary" title="View on map"
                         href="/admin/locations/map-spots">
                        <i class="bi bi-pin-map"></i>
                      </a>
                    <% } %>

                    <% if (s.status !== 'APPROVED') { %>
                      <form method="POST" class="d-inline"
                            action="/admin/locations/spot-suggestions/<%= s.id %>/delete"
                            onsubmit="return confirm('Delete &quot;<%= s.name %>&quot; and its photo for good?');">
                        <input type="hidden" name="back"
                               value="/admin/locations/spot-suggestions<%= statusFilter ? '?status=' + statusFilter : '' %>">
                        <button class="btn btn-sm btn-outline-danger" title="Delete">
                          <i class="bi bi-trash"></i>
                        </button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>

            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <% if (totalPages > 1) { %>
    <% var qs = statusFilter ? '?status=' + statusFilter + '&' : '?'; %>
    <div class="card-footer d-flex justify-content-between align-items-center">
      <small class="text-muted">Page <%= page %> of <%= totalPages %></small>
      <div>
        <a class="btn btn-sm btn-outline-primary <%= page <= 1 ? 'disabled' : '' %>"
           href="/admin/locations/spot-suggestions<%= qs %>page=<%= page - 1 %>">Previous</a>
        <a class="btn btn-sm btn-outline-primary <%= page >= totalPages ? 'disabled' : '' %>"
           href="/admin/locations/spot-suggestions<%= qs %>page=<%= page + 1 %>">Next</a>
      </div>
    </div>
  <% } %>
</div>

<!-- Modals live outside the table: a <div> inside <tbody> is invalid
     HTML and the browser relocates it while parsing, which is how a
     modal ends up half-working. -->
<% if (suggestions && suggestions.length) { %>
  <% suggestions.forEach(function (s) { %>
    <% if (s.status === 'PENDING') { %>
                <!-- Approve: the admin supplies what the user could not -->
                <div class="modal fade" id="approve<%= s.id %>" tabindex="-1">
                  <div class="modal-dialog modal-lg modal-dialog-centered">
                    <form method="POST"
                          action="/admin/locations/spot-suggestions/<%= s.id %>/approve">
                      <input type="hidden" name="back"
                             value="/admin/locations/spot-suggestions<%= statusFilter ? '?status=' + statusFilter : '' %>">
                      <div class="modal-content">
                        <div class="modal-header">
                          <div>
                            <h5 class="modal-title mb-0">Create spot profile</h5>
                            <small class="text-muted">
                              Set the points and radius, then publish to the live map.
                            </small>
                          </div>
                          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                          <div class="row g-3">
                            <div class="col-md-8">
                              <label class="form-label">Spot name</label>
                              <input name="name" class="form-control" required value="<%= s.name %>">
                            </div>
                            <div class="col-md-4">
                              <label class="form-label">Category</label>
                              <select name="categoryKey" class="form-select">
                                <% categories.forEach(function (c) { %>
                                  <option value="<%= c.key %>" <%= c.key === s.categoryKey ? 'selected' : '' %>>
                                    <%= c.title %>
                                  </option>
                                <% }) %>
                              </select>
                            </div>

                            <div class="col-md-8">
                              <label class="form-label">Address</label>
                              <input name="address" class="form-control" value="<%= s.address || '' %>">
                            </div>
                            <div class="col-md-4">
                              <label class="form-label">City</label>
                              <input name="city" class="form-control">
                            </div>

                            <div class="col-12">
                              <label class="form-label">Description</label>
                              <textarea name="description" class="form-control" rows="2"><%= s.note || '' %></textarea>
                            </div>

                            <div class="col-md-6">
                              <label class="form-label">
                                Check-in radius (m) <span class="text-danger">*</span>
                              </label>
                              <input type="number" name="radiusMeters" class="form-control"
                                     value="50" min="10" max="5000" required>
                              <div class="form-text">How close a user must be to check in.</div>
                            </div>
                            <div class="col-md-6">
                              <label class="form-label">
                                Points per check-in <span class="text-danger">*</span>
                              </label>
                              <input type="number" name="points" class="form-control"
                                     value="100" min="1" max="10000" required>
                              <div class="form-text">
                                Google spots derive this from price and reviews; here you set it.
                              </div>
                            </div>

                            <div class="col-12">
                              <div class="card">
                                <div class="card-body">
                                  <div class="row align-items-center g-3">
                                    <div class="col-md-7">
                                      <div class="text-muted small text-uppercase mb-1">
                                        Location — fixed
                                      </div>
                                      <code><%= s.latitude.toFixed(6) %>, <%= s.longitude.toFixed(6) %></code>
                                      <div class="mt-1">
                                        <a href="https://www.google.com/maps?q=<%= s.latitude %>,<%= s.longitude %>"
                                           target="_blank" rel="noopener">
                                          <i class="bi bi-box-arrow-up-right"></i> Open in Google Maps
                                        </a>
                                      </div>
                                      <div class="form-text mb-0">
                                        Where the reporter was standing. Not editable.
                                      </div>
                                    </div>
                                    <% if (s.imageUrl) { %>
                                      <div class="col-md-5 text-md-end">
                                        <img src="<%= s.imageUrl %>" alt=""
                                             style="max-height:120px;border-radius:10px;object-fit:cover">
                                      </div>
                                    <% } %>
                                  </div>
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>
                        <div class="modal-footer">
                          <span class="text-muted small me-auto">
                            <%= personName(s.user) %> gets <%= rewardPoints %> points when you publish.
                          </span>
                          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                          <button class="btn btn-gradient">
                            <i class="bi bi-plus-lg me-2"></i>Publish spot
                          </button>
                        </div>
                      </div>
                    </form>
                  </div>
                </div>

                <!-- Reject: reason is required, the user is shown it -->
                <div class="modal fade" id="reject<%= s.id %>" tabindex="-1">
                  <div class="modal-dialog modal-dialog-centered">
                    <form method="POST"
                          action="/admin/locations/spot-suggestions/<%= s.id %>/reject">
                      <input type="hidden" name="back"
                             value="/admin/locations/spot-suggestions<%= statusFilter ? '?status=' + statusFilter : '' %>">
                      <div class="modal-content">
                        <div class="modal-header">
                          <h5 class="modal-title">Reject "<%= s.name %>"</h5>
                          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                          <label class="form-label">Reason <span class="text-danger">*</span></label>
                          <textarea name="rejectReason" class="form-control" rows="3" required
                                    maxlength="500"
                                    placeholder="e.g. This place is already on the map"></textarea>
                          <div class="form-text">
                            Sent to <%= personName(s.user) %> as a notification — write it
                            for them to read.
                          </div>
                        </div>
                        <div class="modal-footer">
                          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                          <button class="btn btn-danger">Reject and notify</button>
                        </div>
                      </div>
                    </form>
                  </div>
                </div>
              <% } %>
  <% }) %>
<% } %>

<p class="text-muted small mt-3 mb-0">
  Pending suggestions are deleted automatically after 21 days, and rejected ones
  7 days after you act on them — photo included, so the reporter has time to read
  why first. Approved ones are kept as the record behind the live spot; remove
  that from Map Spots instead.
</p>
