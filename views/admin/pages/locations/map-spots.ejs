<%- include('../../partials/flash') %>

<%
  var CAT_TITLE = {};
  categories.forEach(function (c) { CAT_TITLE[c.key] = c.title; });
%>

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-1">
  <div>
    <h1 class="page-title">Map Spots</h1>
    <p class="page-subtitle mb-0">
      Places OutSpot puts on the map itself — the small ones Google doesn't
      carry. They show up in their category alongside Google's results and can
      be checked into for the points set here.
    </p>
  </div>
  <div class="d-flex gap-2">
    <a href="/admin/locations/spot-suggestions" class="btn btn-outline-primary">
      <i class="bi bi-lightbulb me-2"></i>Suggestions
    </a>
    <button class="btn btn-gradient" data-bs-toggle="modal" data-bs-target="#addSpot">
      <i class="bi bi-plus-lg me-2"></i>Add spot
    </button>
  </div>
</div>

<div class="row g-3 mt-1 mb-4">
  <% [
       { label: 'Total spots',         value: total,       icon: 'pin-map' },
       { label: 'Live',                value: activeCount, icon: 'broadcast' },
       { label: 'Points on this page', value: totalPoints, icon: 'coin' }
     ].forEach(function (c) { %>
    <div class="col-6 col-xl-4">
      <div class="stat-card">
        <div class="stat-top">
          <span class="stat-icon"><i class="bi bi-<%= c.icon %>"></i></span>
        </div>
        <div class="stat-value"><%= c.value %></div>
        <div class="stat-label"><%= c.label %></div>
      </div>
    </div>
  <% }) %>
</div>

<div class="mb-3">
  <a href="/admin/locations/map-spots"
     class="btn btn-sm filter-pill rounded-pill <%= categoryFilter === '' ? 'active-all' : '' %>">All</a>
  <% categories.forEach(function (c) { %>
    <a href="/admin/locations/map-spots?category=<%= c.key %>"
       class="btn btn-sm filter-pill rounded-pill <%= categoryFilter === c.key ? 'active-all' : '' %>">
      <%= c.title %>
    </a>
  <% }) %>
</div>

<div class="card">
  <div class="card-body p-0">
    <% if (!spots || spots.length === 0) { %>
      <div class="text-center py-5">
        <i class="bi bi-pin-map" style="font-size:2rem;opacity:.35"></i>
        <p class="text-muted mt-2 mb-0">
          No spots yet. Add one, or approve a user's suggestion.
        </p>
      </div>
    <% } else { %>
      <div class="table-responsive">
      <table class="table table-hover mb-0 align-middle">
        <thead>
          <tr>
            <th style="width:70px">Photo</th>
            <th>Spot</th>
            <th>Category</th>
            <th style="width:90px">Points</th>
            <th style="width:90px">Radius</th>
            <th style="width:110px">Source</th>
            <th style="width:90px">Status</th>
            <th style="width:170px" class="text-end"></th>
          </tr>
        </thead>
        <tbody>
          <% spots.forEach(function (s) { %>
            <tr class="<%= s.active ? '' : 'table-secondary' %>">
              <td>
                <% if (s.imageUrl) { %>
                  <a href="<%= s.imageUrl %>" target="_blank" rel="noopener">
                    <img src="<%= s.imageUrl %>" alt=""
                         style="width:52px;height:52px;object-fit:cover;border-radius:10px">
                  </a>
                <% } else { %><span class="text-muted">—</span><% } %>
              </td>
              <td>
                <div class="fw-semibold"><%= s.name %></div>
                <div class="text-muted small"><%= s.address || '—' %></div>
                <div class="text-muted small">
                  <a href="https://www.google.com/maps?q=<%= s.latitude %>,<%= s.longitude %>"
                     target="_blank" rel="noopener">
                    <%= s.latitude.toFixed(5) %>, <%= s.longitude.toFixed(5) %>
                  </a>
                  · <code><%= s.placeId %></code>
                </div>
              </td>
              <td>
                <span class="badge rounded-pill"
                      style="background:rgba(168,85,247,.16);color:#d8b4fe;font-weight:600">
                  <%= CAT_TITLE[s.categoryKey] || s.categoryKey %>
                </span>
              </td>
              <td><strong><%= s.points %></strong></td>
              <td><%= s.radiusMeters %> m</td>
              <td>
                <% if (s.fromSuggestionId) { %>
                  <span class="badge rounded-pill" style="background:rgba(56,189,248,.18);color:#7dd3fc;font-weight:600">User</span>
                <% } else { %>
                  <span class="badge rounded-pill" style="background:rgba(148,163,184,.18);color:#cbd5e1;font-weight:600">Admin</span>
                <% } %>
              </td>
              <td>
                <% if (s.active) { %>
                  <span class="badge badge-resolved">Live</span>
                <% } else { %>
                  <span class="badge status-declined">Hidden</span>
                <% } %>
              </td>
              <td class="text-end">
                <!-- Plain buttons, not a dropdown: the table scrolls
                     horizontally, and a dropdown opened inside a scroll
                     container gets clipped by it. -->
                <div class="d-flex gap-1 justify-content-end">
                  <button class="btn btn-sm btn-outline-primary"
                          title="<%= s.imageUrl ? 'Replace photo' : 'Add photo' %>"
                          data-bs-toggle="modal" data-bs-target="#photo<%= s.id %>">
                    <i class="bi bi-image"></i>
                  </button>
                  <form method="POST" action="/admin/locations/map-spots/<%= s.id %>/toggle">
                    <input type="hidden" name="back" value="<%= '/admin/locations/map-spots' + (categoryFilter ? '?category=' + categoryFilter : '') %>">
                    <button class="btn btn-sm btn-outline-primary"
                            title="<%= s.active ? 'Hide from map' : 'Show on map' %>">
                      <i class="bi bi-<%= s.active ? 'eye-slash' : 'eye' %>"></i>
                    </button>
                  </form>
                  <form method="POST" action="/admin/locations/map-spots/<%= s.id %>/delete"
                        onsubmit="return confirm('Delete &quot;<%= s.name %>&quot; for good? Check-ins already earned are kept.');">
                    <input type="hidden" name="back" value="<%= '/admin/locations/map-spots' + (categoryFilter ? '?category=' + categoryFilter : '') %>">
                    <button class="btn btn-sm btn-outline-danger" title="Delete">
                      <i class="bi bi-trash"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>

          <% }) %>
        </tbody>
      </table>
      </div>
    <% } %>
  </div>

  <% if (totalPages > 1) { %>
    <% var qs = categoryFilter ? '?category=' + categoryFilter + '&' : '?'; %>
    <div class="card-footer d-flex justify-content-between align-items-center">
      <small class="text-muted">Page <%= page %> of <%= totalPages %> — <%= total %> total</small>
      <div>
        <a class="btn btn-sm btn-outline-primary <%= page <= 1 ? 'disabled' : '' %>"
           href="/admin/locations/map-spots<%= qs %>page=<%= page - 1 %>">Previous</a>
        <a class="btn btn-sm btn-outline-primary <%= page >= totalPages ? 'disabled' : '' %>"
           href="/admin/locations/map-spots<%= qs %>page=<%= page + 1 %>">Next</a>
      </div>
    </div>
  <% } %>
</div>

<!-- Modals live outside the table: a <div> inside <tbody> is invalid
     HTML and the browser relocates it while parsing. -->
<% if (spots && spots.length) { %>
  <% spots.forEach(function (s) { %>
    <!-- Set or replace this spot's photo -->
            <div class="modal fade" id="photo<%= s.id %>" tabindex="-1">
              <div class="modal-dialog">
                <form method="POST" enctype="multipart/form-data"
                      action="/admin/locations/map-spots/<%= s.id %>/photo">
                  <input type="hidden" name="back"
                         value="<%= '/admin/locations/map-spots' + (categoryFilter ? '?category=' + categoryFilter : '') %>">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title"><%= s.imageUrl ? 'Replace' : 'Add' %> photo — <%= s.name %></h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                      <% if (s.imageUrl) { %>
                        <div class="mb-3">
                          <div class="text-muted small">Current</div>
                          <img src="<%= s.imageUrl %>" alt="" class="rounded"
                               style="max-height:140px;object-fit:cover">
                        </div>
                      <% } %>
                      <input type="file" name="imageFile" class="form-control" required
                             accept="image/jpeg,image/png,image/webp,image/gif">
                      <div class="form-text">
                        Up to 5 MB.
                        <% if (s.fromSuggestionId) { %>
                          This spot came from a user's suggestion — replacing the
                          photo here leaves their original on their submission.
                        <% } %>
                      </div>
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                      <button class="btn btn-primary">Save photo</button>
                    </div>
                  </div>
                </form>
              </div>
            </div>
  <% }) %>
<% } %>

<!-- Add spot -->
<div class="modal fade" id="addSpot" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <form method="POST" action="/admin/locations/map-spots"
          enctype="multipart/form-data">
      <div class="modal-content">
        <div class="modal-header">
          <div>
            <h5 class="modal-title mb-0">Add spot to the map</h5>
            <small class="text-muted">
              Click the map to drop a pin. Set what a check-in is worth.
            </small>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Name <span class="text-danger">*</span></label>
              <input name="name" class="form-control" required placeholder="e.g. Rooftop 88">
            </div>
            <div class="col-md-6">
              <label class="form-label">Category <span class="text-danger">*</span></label>
              <select name="categoryKey" class="form-select" required>
                <% categories.forEach(function (c) { %>
                  <option value="<%= c.key %>"><%= c.title %></option>
                <% }) %>
              </select>
            </div>

            <div class="col-md-8">
              <label class="form-label">Address</label>
              <input name="address" class="form-control" placeholder="Street, neighbourhood">
            </div>
            <div class="col-md-4">
              <label class="form-label">City</label>
              <input name="city" class="form-control">
            </div>

            <div class="col-md-6">
              <label class="form-label">Latitude <span class="text-danger">*</span></label>
              <input type="number" step="any" name="latitude" id="spotLat"
                     class="form-control" required value="40.7128">
            </div>
            <div class="col-md-6">
              <label class="form-label">Longitude <span class="text-danger">*</span></label>
              <input type="number" step="any" name="longitude" id="spotLng"
                     class="form-control" required value="-74.0060">
            </div>

            <div class="col-12">
              <div id="spotMap" style="height:280px" class="rounded border"></div>
              <div class="form-text">
                Click anywhere on the map to drop the pin, or type exact coordinates above.
              </div>
            </div>

            <div class="col-md-6">
              <label class="form-label">
                Check-in radius (m) <span class="text-danger">*</span>
              </label>
              <input type="number" name="radiusMeters" class="form-control"
                     value="50" min="10" max="5000" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">
                Points per check-in <span class="text-danger">*</span>
              </label>
              <input type="number" name="points" class="form-control"
                     value="100" min="1" max="10000" required>
            </div>

            <div class="col-12">
              <label class="form-label">Photo</label>
              <input type="file" name="imageFile" class="form-control"
                     accept="image/jpeg,image/png,image/webp,image/gif"
                     onchange="previewSpotPhoto(this)">
              <div class="form-text">
                Optional, up to 5 MB. Shown on the spot's card in the app.
              </div>
              <img id="spotPhotoPreview" alt="" class="rounded mt-2 d-none"
                   style="max-height:120px;object-fit:cover">
            </div>

            <div class="col-12">
              <label class="form-label">Description</label>
              <textarea name="description" class="form-control" rows="2"></textarea>
            </div>

            <div class="col-12">
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch"
                       id="activeSwitch" name="active" checked>
                <label class="form-check-label" for="activeSwitch">
                  <strong>Live</strong> — visible to users for check-ins
                </label>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button class="btn btn-gradient"><i class="bi bi-plus-lg me-2"></i>Publish spot</button>
        </div>
      </div>
    </form>
  </div>
</div>

<script>
  // Shows the chosen file before it is uploaded, so a wrong pick is obvious.
  function previewSpotPhoto(input) {
    var img = document.getElementById('spotPhotoPreview');
    var file = input.files && input.files[0];
    if (!file) { img.classList.add('d-none'); return; }
    img.src = URL.createObjectURL(file);
    img.classList.remove('d-none');
  }
</script>

<% if (mapsApiKey) { %>
  <script>
    // Built only when the modal first opens: a Google map initialised inside a
    // hidden element renders as a grey box.
    var spotMap, spotMarker, spotMapReady = false;

    function initSpotMap() {
      if (spotMapReady || typeof google === 'undefined') return;
      var latEl = document.getElementById('spotLat');
      var lngEl = document.getElementById('spotLng');
      var start = { lat: parseFloat(latEl.value), lng: parseFloat(lngEl.value) };

      spotMap = new google.maps.Map(document.getElementById('spotMap'), {
        center: start, zoom: 12, mapTypeControl: false, streetViewControl: false,
      });
      spotMarker = new google.maps.Marker({
        position: start, map: spotMap, draggable: true,
      });

      function write(pos) {
        latEl.value = pos.lat().toFixed(6);
        lngEl.value = pos.lng().toFixed(6);
      }
      spotMap.addListener('click', function (e) {
        spotMarker.setPosition(e.latLng);
        write(e.latLng);
      });
      spotMarker.addListener('dragend', function (e) { write(e.latLng); });

      // Typing coordinates moves the pin, so the two stay in step.
      [latEl, lngEl].forEach(function (el) {
        el.addEventListener('change', function () {
          var p = {
            lat: parseFloat(latEl.value),
            lng: parseFloat(lngEl.value),
          };
          if (isNaN(p.lat) || isNaN(p.lng)) return;
          spotMarker.setPosition(p);
          spotMap.panTo(p);
        });
      });

      spotMapReady = true;
    }

    document.getElementById('addSpot')
      .addEventListener('shown.bs.modal', function () {
        initSpotMap();
        if (spotMap) google.maps.event.trigger(spotMap, 'resize');
      });
  </script>
  <script async defer
          src="https://maps.googleapis.com/maps/api/js?key=<%= mapsApiKey %>"></script>
<% } else { %>
  <script>
    document.getElementById('spotMap').innerHTML =
      '<div class="text-muted p-4 text-center">' +
      'No Google Maps key configured — type the coordinates instead.</div>';
  </script>
<% } %>
