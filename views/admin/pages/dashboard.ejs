<div class="mb-4">
  <h1 class="page-title">Dashboard</h1>
  <p class="page-subtitle">Live overview of OutSpot activity</p>
</div>

<!-- Stat cards -->
<div class="row g-3 mb-4">
  <div class="col-md-3 col-sm-6">
    <div class="stat-card">
      <div class="stat-top">
        <span class="stat-icon"><i class="bi bi-people"></i></span>
      </div>
      <div class="stat-value"><%= (metrics.newUsersWeek || 0).toLocaleString() %></div>
      <div class="stat-label">New Users (7d)</div>
    </div>
  </div>
  <div class="col-md-3 col-sm-6">
    <div class="stat-card">
      <div class="stat-top">
        <span class="stat-icon"><i class="bi bi-trophy"></i></span>
      </div>
      <div class="stat-value"><%= metrics.activeChallenges || 0 %></div>
      <div class="stat-label">Active Challenges</div>
    </div>
  </div>
  <div class="col-md-3 col-sm-6">
    <div class="stat-card">
      <div class="stat-top">
        <span class="stat-icon"><i class="bi bi-bag-check"></i></span>
      </div>
      <div class="stat-value"><%= (metrics.totalPurchases || 0).toLocaleString() %></div>
      <div class="stat-label">Purchases (30d)</div>
    </div>
  </div>
  <div class="col-md-3 col-sm-6">
    <div class="stat-card">
      <div class="stat-top">
        <span class="stat-icon"><i class="bi bi-flag"></i></span>
      </div>
      <div class="stat-value"><%= metrics.pendingReports || 0 %></div>
      <div class="stat-label">Open Reports</div>
    </div>
  </div>
</div>

<div class="row g-3">
  <!-- Recent Reports -->
  <div class="col-lg-7">
    <div class="card h-100">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-flag me-2 text-secondary"></i>Recent Reports &amp; Flagged Content</span>
        <a href="/admin/reports" class="btn btn-sm btn-outline-primary">View All</a>
      </div>
      <div class="card-body p-0">
        <% if (recentReports.length === 0) { %>
          <p class="text-secondary p-3 mb-0">No pending reports.</p>
        <% } else { %>
          <table class="table table-hover mb-0">
            <thead><tr><th>Reporter</th><th>Reported</th><th>Reason</th><th>Status</th></tr></thead>
            <tbody>
              <% recentReports.forEach(r => { %>
                <tr>
                  <td><a href="/admin/users/<%= r.reporter.id %>"><%= r.reporter.username %></a></td>
                  <td><a href="/admin/users/<%= r.reported.id %>"><%= r.reported.username %></a></td>
                  <td><%= r.reason || '-' %></td>
                  <td><span class="badge badge-<%= (r.status || 'pending').toLowerCase() %>"><%= r.status || 'PENDING' %></span></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Latest Users / Activity -->
  <div class="col-lg-5">
    <div class="card h-100">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-activity me-2 text-secondary"></i>Latest Users</span>
        <a href="/admin/users" class="btn btn-sm btn-outline-primary">View All</a>
      </div>
      <div class="card-body p-0">
        <% if (!recentUsers || recentUsers.length === 0) { %>
          <p class="text-secondary p-3 mb-0">No recent users.</p>
        <% } else { %>
          <% recentUsers.forEach(u => {
               const avatar = (u.minime && u.minime[0] && u.minime[0].avatarUrl) || null;
               const fullName = [u.firstName, u.lastName].filter(Boolean).join(' ') || u.username;
               const initials = (fullName || '?').trim().split(/\s+/).map(s => s[0]).slice(0, 2).join('').toUpperCase();
          %>
            <div class="activity-row d-flex justify-content-between align-items-center">
              <a href="/admin/users/<%= u.id %>" class="user-cell">
                <% if (avatar) { %>
                  <img src="<%= avatar %>" class="user-avatar" alt="">
                <% } else { %>
                  <span class="user-avatar-fallback"><%= initials %></span>
                <% } %>
                <span>
                  <span class="user-name d-block"><%= fullName %></span>
                  <span class="user-email"><%= u.email || u.phone || 'no email' %></span>
                </span>
              </a>
              <div class="text-end">
                <div class="fw-semibold"><%= u.totalPoints %> pts</div>
                <div class="meta"><%= u.createdAt.toLocaleDateString() %></div>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>
  </div>
</div>
