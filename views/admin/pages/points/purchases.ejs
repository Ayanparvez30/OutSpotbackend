<div class="d-flex justify-content-between align-items-center mb-3">
  <span class="text-muted"><%= total %> purchases</span>
  <div class="d-flex gap-2">
    <a href="/admin/points/multipliers" class="btn btn-sm btn-outline-secondary">Multipliers</a>
    <a href="/admin/points/bundles" class="btn btn-sm btn-outline-secondary">Bundles</a>
  </div>
</div>

<div class="card">
  <div class="card-body p-0">
    <table class="table table-hover mb-0 align-middle">
      <thead>
        <tr><th>ID</th><th>User</th><th>Product</th><th>Points</th><th>Store Price</th><th>Date</th></tr>
      </thead>
      <tbody>
        <% purchases.forEach(p => {
             const u = p.user;
             const avatar = (u.minime && u.minime[0] && u.minime[0].avatarUrl) || null;
             const fullName = [u.firstName, u.lastName].filter(Boolean).join(' ') || u.username;
             const initials = (fullName || '?').trim().split(/\s+/).map(s => s[0]).slice(0, 2).join('').toUpperCase();
        %>
          <tr>
            <td><%= p.id %></td>
            <td>
              <a href="/admin/users/<%= u.id %>" class="user-cell">
                <% if (avatar) { %>
                  <img src="<%= avatar %>" class="user-avatar" alt="">
                <% } else { %>
                  <span class="user-avatar-fallback"><%= initials %></span>
                <% } %>
                <span class="user-name"><%= u.username %></span>
              </a>
            </td>
            <td><%= p.productId %></td>
            <td><%= p.points %></td>
            <td>$<%= Number(p.priceUsd).toFixed(2) %></td>
            <td><%= p.createdAt.toLocaleString() %></td>
          </tr>
        <% }) %>
        <% if (purchases.length === 0) { %>
          <tr><td colspan="6" class="text-center text-muted py-3">No purchases found.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../../partials/pagination', { page, totalPages, baseUrl }) %>
