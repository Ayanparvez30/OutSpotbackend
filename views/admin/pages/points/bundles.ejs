<div class="d-flex justify-content-between align-items-start mb-4">
  <div>
    <h1 class="page-title">Bundles &amp; Purchases</h1>
    <p class="page-subtitle">Point bundles and purchases</p>
  </div>
  <a href="/admin/points/bundles/create" class="btn btn-gradient"><i class="bi bi-plus-lg me-1"></i>Create</a>
</div>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <span class="text-muted"><%= bundles.length %> bundles</span>
  <div class="d-flex gap-2">
    <a href="/admin/points/multipliers" class="btn btn-sm btn-outline-secondary">Multipliers</a>
    <a href="/admin/points/purchases" class="btn btn-sm btn-outline-secondary">Purchases</a>
  </div>
</div>

<div class="card">
  <div class="card-body p-0">
    <table class="table table-hover mb-0">
      <thead>
        <tr><th>ID</th><th>Product ID</th><th>Apple SKU</th><th>Google SKU</th><th>Points</th><th>Active</th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% bundles.forEach(b => { %>
          <tr>
            <td><%= b.id %></td>
            <td><%= b.productId %></td>
            <td><%= b.appleProductId || '-' %></td>
            <td><%= b.googleProductId || '-' %></td>
            <td><%= b.points %></td>
            <td>
              <% if (b.isActive) { %>
                <span class="status-pill status-active">Active</span>
              <% } else { %>
                <span class="status-pill status-inactive">Inactive</span>
              <% } %>
            </td>
            <td><a href="/admin/points/bundles/<%= b.id %>/edit" class="row-action" title="Edit"><i class="bi bi-pencil"></i></a></td>
          </tr>
        <% }) %>
        <% if (bundles.length === 0) { %>
          <tr><td colspan="7" class="text-center text-muted py-3">No bundles.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
