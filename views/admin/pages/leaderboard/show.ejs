<div class="mb-3">
  <a href="/admin/leaderboard" class="text-muted text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Leaderboard</a>
</div>

<!-- Community header -->
<div class="card mb-4">
  <div class="card-body d-flex justify-content-between align-items-start flex-wrap gap-3">
    <div class="d-flex gap-3">
      <% if (community.imageUrl) { %>
        <img src="<%= community.imageUrl %>" class="community-hero" alt="">
      <% } else { %>
        <span class="community-hero community-thumb-fallback"><i class="bi bi-people"></i></span>
      <% } %>
      <div>
        <h1 class="page-title mb-1"><%= community.name %></h1>
        <p class="page-subtitle mb-0">Member leaderboard · weekly window <%= weekLabel %></p>
      </div>
    </div>
    <div class="text-end">
      <div class="stat-value" style="font-size:1.5rem"><%= community._count.members.toLocaleString() %></div>
      <div class="stat-label">Members</div>
    </div>
  </div>
</div>

<!-- Member ranking -->
<div class="card">
  <div class="card-body p-0">
    <table class="table table-hover mb-0 align-middle">
      <thead>
        <tr>
          <th style="width:60px">#</th>
          <th>User</th>
          <th class="text-end">Weekly pts</th>
          <th class="text-end">All-time pts</th>
          <th>Joined</th>
        </tr>
      </thead>
      <tbody>
        <% members.forEach(m => {
             const initials = (m.fullName || '?').trim().split(/\s+/).map(s => s[0]).slice(0, 2).join('').toUpperCase();
        %>
          <tr>
            <td class="fw-bold text-muted"><%= m.rank %></td>
            <td>
              <a href="/admin/users/<%= m.id %>" class="user-cell">
                <% if (m.avatarUrl) { %>
                  <img src="<%= m.avatarUrl %>" class="user-avatar" alt="">
                <% } else { %>
                  <span class="user-avatar-fallback"><%= initials %></span>
                <% } %>
                <span>
                  <span class="user-name d-block"><%= m.fullName %></span>
                  <span class="user-email"><%= m.contact || 'no email' %></span>
                </span>
              </a>
            </td>
            <td class="text-end"><%= m.weeklyPoints.toLocaleString() %></td>
            <td class="text-end fw-semibold"><%= m.allTimePoints.toLocaleString() %></td>
            <td><%= m.joinedAt.toLocaleDateString() %></td>
          </tr>
        <% }) %>
        <% if (members.length === 0) { %>
          <tr><td colspan="5" class="text-center text-muted py-3">No members yet.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
