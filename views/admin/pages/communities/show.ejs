<div class="mb-3">
  <a href="/admin/communities" class="text-muted text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Communities</a>
</div>

<!-- Community header -->
<div class="card mb-4">
  <div class="card-body d-flex justify-content-between align-items-start flex-wrap gap-3">
    <div class="d-flex gap-3">
      <% if (community.imageUrl) { %>
        <img src="<%= community.imageUrl %>" class="community-hero" alt="">
      <% } else { %>
        <span class="community-hero community-thumb-fallback"><i class="bi bi-people"></i></span>
      <% } %>
      <div>
        <h1 class="page-title mb-1"><%= community.name %></h1>
        <p class="page-subtitle mb-2">
          Created by
          <a href="/admin/users/<%= community.creator.id %>">@<%= community.creator.username %></a>
        </p>
        <% if (community.bio) { %><p class="mb-0 text-secondary"><%= community.bio %></p><% } %>
      </div>
    </div>
    <div class="d-flex align-items-center gap-3">
      <div class="text-end">
        <div class="stat-value" style="font-size:1.5rem"><%= community._count.members.toLocaleString() %></div>
        <div class="stat-label">Members</div>
      </div>
      <a href="/admin/communities/<%= community.id %>/edit" class="btn btn-gradient"><i class="bi bi-pencil me-2"></i>Edit</a>
    </div>
  </div>
</div>

<!-- Members -->
<div class="card">
  <div class="card-header"><strong>Members (<%= community._count.members %>)</strong></div>
  <div class="card-body p-0">
    <% if (!community.members || community.members.length === 0) { %>
      <p class="text-secondary p-3 mb-0">No members yet.</p>
    <% } else { %>
      <table class="table table-hover mb-0 align-middle">
        <thead>
          <tr><th>User</th><th>Points</th><th>Joined</th></tr>
        </thead>
        <tbody>
          <% community.members.forEach(m => {
               const u = m.user;
               const avatar = (u.minime && u.minime[0] && u.minime[0].avatarUrl) || null;
               const fullName = [u.firstName, u.lastName].filter(Boolean).join(' ') || u.username;
               const initials = (fullName || '?').trim().split(/\s+/).map(s => s[0]).slice(0, 2).join('').toUpperCase();
          %>
            <tr>
              <td>
                <a href="/admin/users/<%= u.id %>" class="user-cell">
                  <% if (avatar) { %>
                    <img src="<%= avatar %>" class="user-avatar" alt="">
                  <% } else { %>
                    <span class="user-avatar-fallback"><%= initials %></span>
                  <% } %>
                  <span>
                    <span class="user-name d-block"><%= fullName %></span>
                    <span class="user-email"><%= u.email || u.phone || 'no email' %></span>
                  </span>
                </a>
              </td>
              <td class="fw-semibold"><%= (u.totalPoints || 0).toLocaleString() %></td>
              <td><%= m.joinedAt.toLocaleDateString() %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>
